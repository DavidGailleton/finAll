# The Cargo package and server executable name.
APP_NAME=fin-all

# Development ports.
APP_PORT=3000
RELOAD_PORT=3001
POSTGRES_PORT=5432

# PostgreSQL.
POSTGRES_DB=finall
POSTGRES_USER=finall

# Replace this before starting the containers.
# Prefer hexadecimal characters to avoid URL-encoding problems in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_value

# Rust logging.
RUST_LOG=info

# Set to 1 (or true) to apply pending database migrations on app startup.
# Off by default; otherwise run `sqlx migrate run` out of band before deploying.
RUN_MIGRATIONS=0

# Dev only: whenever LEPTOS_ENV=DEV (compose.dev.yaml sets this), the app seeds
# a demo login with a few example accounts/categories/merchants/transactions on
# startup (idempotent, and never seeded when LEPTOS_ENV=PROD). No env var to
# set here; the credentials are fixed in src/server/seed.rs:
#   demo@example.test / demo-password-123

# Frankfurter API root. Leave unset for the public api.frankfurter.dev; set it
# to a self-hosted instance or mirror serving the same v2 /v2/rates and
# /v2/currencies shapes. No trailing slash. The app syncs the currency list from
# it at startup and monthly, and fetches exchange rates on demand (never stored).
# FRANKFURTER_URL=https://api.frankfurter.dev

# Production domain.
APP_DOMAIN=app.example.com

# Email used for certificate-expiration notifications.
ACME_EMAIL=you@example.com

# Keep this pinned so builds are reproducible.
CARGO_LEPTOS_VERSION=0.3.6

# SQLX version
SQLX_CLI_VERSION=0.9.0
