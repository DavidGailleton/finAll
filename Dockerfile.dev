# syntax=docker/dockerfile:1.7

FROM rust:1.98.0-trixie

ARG CARGO_LEPTOS_VERSION=0.3.6
ARG SQLX_CLI_VERSION=0.9.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        curl \
        git \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl \
      --proto '=https' \
      --tlsv1.2 \
      -LsSf \
      "https://github.com/leptos-rs/cargo-leptos/releases/download/v${CARGO_LEPTOS_VERSION}/cargo-leptos-installer.sh" \
    | sh

RUN rustup target add wasm32-unknown-unknown \
    && rustup component add clippy rustfmt

RUN cargo install sqlx-cli \
    --version "${SQLX_CLI_VERSION}" \
    --locked \
    --no-default-features \
    --features rustls,postgres

WORKDIR /app

EXPOSE 3000
EXPOSE 3001

CMD ["cargo", "leptos", "watch"]
