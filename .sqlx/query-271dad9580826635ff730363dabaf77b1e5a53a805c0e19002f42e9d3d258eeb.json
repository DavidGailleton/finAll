{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id AS \"id!\",\n            a.deleted_at,\n            a.asset_name AS \"asset_name!\",\n            a.symbol,\n            f.numeric_code\n        FROM assets AS a\n        LEFT JOIN fiat_assets AS f ON f.asset_id = a.id\n        WHERE a.asset_class = 'fiat' AND a.code = $1\n        ",
