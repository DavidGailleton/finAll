  "query": "\n        SELECT\n            a.id,\n            a.code AS alphabetic_code,\n            f.minor_units AS \"minor_units!\"\n        FROM assets AS a\n        INNER JOIN fiat_assets AS f ON f.asset_id = a.id\n        WHERE a.id = $1\n        ",
