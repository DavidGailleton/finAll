  "query": "\n        SELECT\n            ab.asset_id AS \"asset_id!\",\n            a.code AS \"alphabetic_code!\",\n            ab.balance AS \"balance!\"\n        FROM account_balances AS ab\n        INNER JOIN assets AS a ON a.id = ab.asset_id\n        WHERE ab.user_id = $1 AND ab.account_id = $2\n        ",
