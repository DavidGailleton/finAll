{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE sessions AS s\n        SET last_used_at = now(),\n            expires_at = now() + make_interval(days => $2)\n        FROM users AS u\n        WHERE s.token_hash = $1\n          AND s.expires_at > now()\n          AND u.id = s.user_id\n          AND u.deleted_at IS NULL\n        RETURNING\n            u.id AS \"user_id!\",\n            u.email AS \"email!\",\n            u.display_name\n        ",
