{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id,\n            a.code AS alphabetic_code,\n            f.numeric_code,\n            a.asset_name AS currency_name,\n            a.symbol,\n            f.minor_units AS \"minor_units!\",\n            a.is_active\n        FROM assets AS a\n        INNER JOIN fiat_assets AS f ON f.asset_id = a.id\n        WHERE a.asset_class = 'fiat' AND a.is_active = TRUE AND a.deleted_at IS NULL\n        ORDER BY a.code\n        ",
