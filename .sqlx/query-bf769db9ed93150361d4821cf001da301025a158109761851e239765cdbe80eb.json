{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id AS session_id,\n            u.id AS \"user_id!\",\n            u.email AS \"email!\",\n            u.display_name,\n            (s.last_used_at < now() - make_interval(hours => $2)) AS \"needs_slide!\"\n        FROM sessions AS s\n        INNER JOIN users AS u ON u.id = s.user_id\n        WHERE s.token_hash = $1\n          AND s.expires_at > now()\n          AND u.deleted_at IS NULL\n        ",
