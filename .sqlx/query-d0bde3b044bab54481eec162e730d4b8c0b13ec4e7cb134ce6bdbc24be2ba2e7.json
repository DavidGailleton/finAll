{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id,\n            a.code AS alphabetic_code,\n            f.minor_units AS \"minor_units!\"\n        FROM assets AS a\n        INNER JOIN fiat_assets AS f ON f.asset_id = a.id\n        WHERE\n            a.asset_class = 'fiat'\n            AND a.is_active = TRUE\n            AND a.deleted_at IS NULL\n            AND a.code = $1\n        ",
